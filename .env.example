# Local defaults. Copy to .env for customization. Never commit .env.
DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
POSTGRES_DB=workshop
POSTGRES_USER=workshop
POSTGRES_PASSWORD=local-workshop-password
SITE_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:3000
SEED_DEMO=true
SECURE_SSL_REDIRECT=false

# Configure notifications before accepting real requests.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=workshop@localhost
LEAD_NOTIFICATION_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional private S3/MinIO buckets. Use storage in the required jurisdiction.
USE_S3=false
S3_ENDPOINT_URL=
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
